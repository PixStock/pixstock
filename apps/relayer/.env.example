# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5183

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pixstock

# ── Solana ───────────────────────────────────────────────────────────────
# Jupiter routes and xStocks only exist on mainnet, and so do the address
# lookup tables an order's transaction points at.
SOLANA_CLUSTER=mainnet-beta

# The public endpoint works and needs no key: enough to build orders, too rate
# limited to run a demo on. Put a Helius URL here before the video.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# The relayer's identity. With only the public key it can build orders and
# be their fee payer on paper, but not co-sign or broadcast them.
RELAYER_PUBKEY=

# Hot key: fee payer and nonce authority ONLY. Never signs a token transfer,
# never holds a user key. Cap at 0.3 SOL. NEVER COMMIT A REAL VALUE.
RELAYER_SECRET_KEY=
NONCE_POOL_SIZE=10

# Sending a transaction spends real SOL and cannot be undone, so it is off
# until someone turns it on deliberately. Everything else — building, quoting,
# co-signing, simulating — works with this false, which is what makes it safe
# to develop against mainnet. Set it to true for the demo, and only then.
RELAYER_ALLOW_BROADCAST=false

# ── Jupiter ──────────────────────────────────────────────────────────────
# lite-api needs no key and is fine for development.
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# ── Pyth Pro (ex-Lazer) ──────────────────────────────────────────────────
# Self-service token from pythdata.app. Required for the offline price check.
PYTH_PRO_TOKEN=
PYTH_ROUTER_URLS=wss://pyth-lazer-0.dourolabs.app/v1/stream

# ── Policy caps ──────────────────────────────────────────────────────────
MAX_SLIPPAGE_BPS=100
MAX_RENT_LAMPORTS=10000000
