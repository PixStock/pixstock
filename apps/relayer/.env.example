# ── Runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pixstock

# ── Solana ───────────────────────────────────────────────────────────────
SOLANA_CLUSTER=devnet
# Helius free tier. The public endpoint is too rate limited to build against.
SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=

# Hot key: fee payer and nonce authority ONLY. Never signs a token transfer,
# never holds a user key. Cap at 0.3 SOL. NEVER COMMIT A REAL VALUE.
RELAYER_SECRET_KEY=
NONCE_POOL_SIZE=10

# ── Jupiter ──────────────────────────────────────────────────────────────
# lite-api needs no key and is fine for development.
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# ── Pyth Pro (ex-Lazer) ──────────────────────────────────────────────────
# Self-service token from pythdata.app. Required for the offline price check.
PYTH_PRO_TOKEN=
PYTH_ROUTER_URLS=wss://pyth-lazer-0.dourolabs.app/v1/stream

# ── Policy caps ──────────────────────────────────────────────────────────
MAX_SLIPPAGE_BPS=100
MAX_RENT_LAMPORTS=10000000
